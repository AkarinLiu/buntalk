# bunbolt configuration — copy to `.env` and edit.
# Bun loads `.env` automatically, so nothing else is required.

# ---- Database ----------------------------------------------------------
# Unset means a local SQLite file, so a fresh clone runs with zero config.
# All three engines are supported by the same code:
#DATABASE_URL=./bunbolt.db
#DATABASE_URL=postgres://user:password@localhost:5432/bunbolt
#DATABASE_URL=mysql://user:password@localhost:3306/bunbolt

# The schema is created on first boot; there is no migration step to run.

# ---- Uploads -----------------------------------------------------------
# Local disk by default. Files are written to UPLOAD_DIR and served from
# /uploads/<key>, so the public URL never depends on the storage backend —
# which is what makes migrating to S3 a plain file copy.
#UPLOAD_DIR=./uploads
#MAX_UPLOAD_MB=5

# ---- S3-compatible storage --------------------------------------------
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2 and DigitalOcean
# Spaces. Filling in the bucket and credentials is enough: the driver flips
# to s3 on its own. Give a custom endpoint for anything other than AWS.
#S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#S3_REGION=auto
#S3_BUCKET=bunbolt
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=

# Set only when the bucket is publicly readable. Left unset, objects are
# served through short-lived presigned URLs instead.
#S3_PUBLIC_URL=https://cdn.example.com
#S3_URL_TTL=3600

# Overrides the auto-detection above. `local` wins even if credentials exist.
#STORAGE_DRIVER=s3

# Migrate existing files:  bun run migrate:s3

# ---- Server ------------------------------------------------------------
#PORT=3000

# Required when NODE_ENV=production; development falls back to a known
# insecure value. Generate one with: openssl rand -hex 32
#SESSION_SECRET=

# Set to `production` to enable secure (HTTPS-only) session cookies.
# In production, SESSION_SECRET must be set or the server refuses to start.
#NODE_ENV=production
